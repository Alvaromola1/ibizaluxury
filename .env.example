# === BASE DE DATOS (NEON.TECH) ===
# La URL de tu base de datos PostgreSQL. Nunca la compartas ni la subas a GitHub real sin cifrar.
DATABASE_URL="postgresql://usuario:password@tu-endpoint.neon.tech/neondb?sslmode=require"

# === ACCESO AL PANEL DE ADMIN ===
# Contraseña segura para acceder a la ruta /admin donde verás tus leads
ADMIN_PASSWORD="tu_contraseña_super_segura_aqui"

# === CONFIGURACIÓN DE ENVÍO DE EMAILS (RESEND) ===
# Si usas Resend.com para enviar emails a través de Nodemailer, usa estas credenciales:
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
# Pega aquí tu API Key de Resend (empieza por re_...)
SMTP_PASS="re_tu_api_key_aqui"

# Email donde quieres recibir los avisos de nuevos leads
LEAD_NOTIFY_EMAIL="info@ibizaluxurydreams.com"
# Email desde el que se enviarán (debe estar verificado en Resend)
EMAIL_FROM="info@ibizaluxurydreams.com"

# === WHATSAPP BUSINESS API (META) ===
# Credenciales de tu app de WhatsApp Business Cloud API.
WHATSAPP_ACCESS_TOKEN="tu_token_de_acceso"
WHATSAPP_PHONE_NUMBER_ID="tu_phone_number_id"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="tu_token_de_verificacion"
WHATSAPP_API_VERSION="v22.0"

# === METRICAS Y ANALÍTICA (META ADS) ===
# Tu ID de Pixel de Meta (Facebook/Instagram). Si no tienes aún, déjalo vacío.
NEXT_PUBLIC_META_PIXEL_ID="tu_id_del_pixel_aqui"
